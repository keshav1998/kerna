{
  "name": "kerna",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "packages/email/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "test": "turbo test --parallel",
    "start:dashboard": "turbo start --filter=@kerna/dashboard",
    "start:website": "turbo start --filter=@kerna/website",
    "dev:api": "turbo dev --filter=@kerna/api",
    "dev:dashboard": "turbo dev --filter=@kerna/dashboard",
    "build:dashboard": "turbo build --filter=@kerna/dashboard",
    "dev:engine": "turbo dev --filter=@kerna/engine",
    "dev:website": "turbo dev --filter=@kerna/website ",
    "dev:desktop": "turbo dev --filter=@kerna/desktop",
    "jobs:dashboard": "turbo jobs --filter=@kerna/jobs",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@biomejs/biome": "1.9.4",
    "@manypkg/cli": "^0.25.1",
    "turbo": "2.6.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.2.22"
}
